{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2023"],
		"module": "node18",
		"moduleResolution": "node16",
		"types": ["node", "jest"],
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"removeComments": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"isolatedModules": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true
	},
	"include": ["src/**/*.ts", "bench/**/*.ts"]
}
